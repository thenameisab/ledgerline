# Ledgerline local development settings
#
#   cp .env.local.example .env.local   # then: npm install && npm run dev
#
# The defaults below work for local development. No Docker, external accounts,
# or API keys are necessary.

# ─── Database ─────────────────────────────────────────────────────────────────
# `npm run dev` starts an embedded Postgres server on port 54329 (data in
# ./.pgdata), applies the schema, and seeds fictional data on the first run.
# scripts/local.ts sets DATABASE_URL to this address for the processes it
# starts. Scripts that you run directly (npm run vendor-sync, npx tsx ...) read
# this value. Set LOCAL_PG_PORT to use another port, and change the port here
# to match. src/lib/db.ts turns on SSL when the URL has sslmode=require or a
# neon.tech host.
DATABASE_URL=postgres://ledgerline:ledgerline@localhost:54329/ledgerline
# LOCAL_PG_PORT=54329

# ─── Auth ─────────────────────────────────────────────────────────────────────
# The login page has "Enter as Admin" and "Enter as Member" buttons. They use a
# demo Credentials provider (src/auth.ts) that signs in seeded users. There are
# no passwords.
AUTH_SECRET=local-dev-secret-change-me
# AUTH_URL is not needed for sign-in: `trustHost: true` in src/auth.ts takes the
# origin from the request. Ledgerline uses AUTH_URL to build links in emails and
# in the invite banner (default http://localhost:3000).
# AUTH_URL=http://localhost:3000
AUTH_DEMO_ADMIN_EMAIL=admin@ledgerline.local

# Set to "true" to skip the login page and open the app as the seeded admin.
# The app refuses to start with this flag when NODE_ENV is "production".
AUTH_BYPASS=false

# ─── Mock integrations ────────────────────────────────────────────────────────
# When "true", the usage sync and the vendor-side usage pull do not call an
# external source. "Refresh now" and "Backfill" generate usage locally.
MOCK_INTEGRATIONS=true

# ─── Briefing composer ────────────────────────────────────────────────────────
# Read by src/lib/config.ts. Keep "false" for local development.
BRIEFING_LLM_ENABLED=false

# ─── Cron routes ──────────────────────────────────────────────────────────────
# Routes under /api/cron require "Authorization: Bearer <CRON_SECRET>". Local
# development has no scheduler, so call a route by hand. Add ?dry=1 to a digest
# route (or ?dry=daily to the alerts route) to preview the email as HTML:
#   curl -H "Authorization: Bearer local-dev-cron-secret" \
#     "http://localhost:3000/api/cron/alerts?dry=daily"
#   curl -H "Authorization: Bearer local-dev-cron-secret" \
#     "http://localhost:3000/api/cron/product-update-weekly?dry=1"
CRON_SECRET=local-dev-cron-secret

# ─── Optional ─────────────────────────────────────────────────────────────────
# Approval threshold for manual entries, in dollars (default 500).
# MANUAL_ENTRY_APPROVAL_THRESHOLD=500
# Publishable key for the logo lookup on account profiles. When it is unset,
# the lookup returns an error and logo upload still works.
# LOGODEV_PUBLISHABLE_KEY=
# Mail credentials are not set, so email sends are skipped and logged.
